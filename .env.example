# ================================================================
# CivicAgent Environment Configuration Example
# ================================================================

# Primary Gemini API Key (Multimodal OCR & Vision Grounding) - Uses Gemini 3.5 Flash
CIVICAGENT_GEMINI_API_KEY="your_primary_gemini_api_key_here"

# Fallback Gemini API Keys (Comma-separated, used when primary reaches limit/quota) - Uses Gemini 2.5 Flash
CIVICAGENT_GEMINI_FALLBACK_KEYS="fallback_key_1,fallback_key_2"

# Model Engine (Primary: 3.5 Flash | Fallback: 2.5 Flash)
CIVICAGENT_MODEL="gemini-3.5-flash"
CIVICAGENT_FALLBACK_MODEL="gemini-2.5-flash"

# Open Government Data (data.gov.in) API Key
CIVICAGENT_DATA_GOV_API_KEY="your_data_gov_in_api_key_here"
